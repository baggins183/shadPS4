#version 460

#extension GL_EXT_shared_memory_block : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

#pragma use_vulkan_memory_model

layout(std430, set = 0, binding = UTILITY_BUFFER_BINDING) buffer ordered_count_utility
{
    // TODO play with offsets for cache opts
    uint next_emulated_workgroup_index;
    uint counters[NUM_COUNTERS];
};

layout(std430, set = 0, binding = GDS_BUFFER_BINDING) buffer gds_buffer
{
    uint gds_data[];
};

uint current_counter = 0;

uint init_emulated_workgroup_index() {
#if 1
    // TODO, initializer to 0 doesn't seem to be working
    current_counter = 0;
#endif
    return atomicAdd(next_emulated_workgroup_index, 1);
}

uint ordered_count_add_per_wave(uint value, uint gds_offset, uint append_term, bool elected, bool is_active)
{
    uint prev_count = 0;
    uint gds_index = gds_offset >> 2;

    if (elected) {
        for (;;) {
            uint next_writer = atomicLoad(counters[current_counter], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquire);
            if (next_writer == append_term) {
                break;
            }
        }

        // skip the atomic when no active threads, but always need to do rest of the
        // logic
        if (is_active) {
            prev_count = atomicAdd(gds_data[gds_index], value);
        }

        atomicStore(counters[current_counter], append_term + 1, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
    }

    ++current_counter;
    return prev_count;
}

uint ordered_count_swap_per_wave(uint value, uint gds_offset, uint append_term, bool elected, bool is_active)
{
    uint prev_count = 0;
    uint gds_index = gds_offset >> 2;

    if (elected) {
        for (;;) {
            uint next_writer = atomicLoad(counters[current_counter], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquire);
            if (next_writer == append_term) {
                break;
            }
        }

        // skip the atomic when no active threads, but always need to do rest of the
        // logic
        if (is_active) {
            prev_count = atomicExchange(gds_data[gds_index], value);
        }

        atomicStore(counters[current_counter], append_term + 1, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
    }

    ++current_counter;
    return prev_count;
}